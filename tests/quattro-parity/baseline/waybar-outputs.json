{
  "custom/claude": {
    "cmd": "$HOME/dotfiles/scripts/waybar-claude-status",
    "rc": 0,
    "stdout": "{\"text\":\"✳ 1\",\"class\":\"active\",\"tooltip\":\"Claude Code: 1 session(s)\\nclick: focus WezTerm\"}"
  },
  "custom/spurs": {
    "cmd": "$HOME/dotfiles/scripts/waybar-spurs-fixture",
    "rc": 0,
    "stdout": "{\"text\": \"󱟃 vs Ipswich Town 11/22 00:00\", \"class\": \"fixture\", \"tooltip\": \"Tottenham Hotspur vs Ipswich Town\\nEnglish Premier League (H)\\n2026-11-22 00:00 kickoff\"}"
  },
  "custom/dotfiles": {
    "cmd": "$HOME/dotfiles/scripts/waybar-dotfiles-status",
    "rc": 0,
    "stdout": "{\"text\":\" 5\",\"class\":\"dirty\",\"tooltip\":\"dotfiles: 5 uncommitted change(s)\\nclick: lazygit\"}"
  },
  "custom/update": {
    "cmd": "omarchy-update-available",
    "rc": 0,
    "stdout": "Omarchy update available (v4.5.0-rc3)"
  },
  "custom/weather": {
    "cmd": "$OMARCHY_PATH/default/waybar/weather.sh",
    "rc": 0,
    "stdout": "{\"text\":\"\"}"
  },
  "custom/screenrecording-indicator": {
    "cmd": "$OMARCHY_PATH/default/waybar/indicators/screen-recording.sh",
    "rc": 0,
    "stdout": "{\"text\": \"\"}"
  },
  "custom/idle-indicator": {
    "cmd": "$HOME/dotfiles/scripts/dotfiles-idle status",
    "rc": 0,
    "stdout": "{\"text\":\"󰒲\",\"tooltip\":\"自動ロック: 有効 (放置でスクリーンセーバー → ロック)\\n左クリック: 止める / 右クリック: 1時間だけ止める\",\"class\":\"enabled\"}"
  },
  "custom/notification-silencing-indicator": {
    "cmd": "$OMARCHY_PATH/default/waybar/indicators/notification-silencing.sh",
    "rc": 0,
    "stdout": "{\"text\": \"\"}"
  }
}