#!/bin/bash

set -euo pipefail

ROOT="${DOTFILES_ROOT:-$HOME/dotfiles}"
profile="${1:-$(hostname)}"
# Omarchy 4 (Quattro) は Lua 構成 (monitors.lua)、3.x は .conf 構成 (monitors.conf)
if [[ -e /usr/share/omarchy/default/hypr/bootstrap.lua ]]; then
  ext=lua
else
  ext=conf
fi
source_file="$ROOT/profiles/$profile/hypr/monitors.$ext"
target_file="$HOME/.config/hypr/monitors.$ext"

if [[ ! -f $source_file ]]; then
  printf 'Unknown host profile: %s\n' "$profile" >&2
  exit 1
fi

if cmp -s "$source_file" "$target_file"; then
  printf 'Monitor profile is already active: %s\n' "$profile"
  exit 0
fi

# 初回 (ターゲット未作成) はバックアップするものが無い。set -e で落ちないよう存在時だけ
if [[ -e $target_file ]]; then
  cp -p "$target_file" "$target_file.bak.$(date +%s)"
fi
install -m 0644 "$source_file" "$target_file"
hyprctl reload

errors=$(hyprctl configerrors)
if [[ -n $errors ]]; then
  printf '%s\n' "$errors" >&2
  exit 1
fi

printf 'Applied monitor profile: %s\n' "$profile"
