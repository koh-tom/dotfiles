#!/bin/bash

# Claude Codeのhookから呼ばれ、WezTermのペインuser var "claude_state" を更新する。
# WezTerm側 (tab.lua) がこの値でタブアイコンの色を変える。
#   working   = 処理中 / waiting = 入力待ち / attention = 許可待ち等の通知 / (空) = 終了
#
# hookはターミナル配下で走るので /dev/tty へ OSC 1337 SetUserVar を直接書く。
# tty が無いコンテキスト (headless等) では静かに何もしない。失敗してもhookを止めない。

state="${1:-}"

# hook の入力 (JSON: cwd, message など) は stdin で来る。通知の文面に使う
hook_json=""
[[ -t 0 ]] || hook_json=$(timeout 1 cat 2>/dev/null)

{
  if [[ -w /dev/tty ]]; then
    printf '\033]1337;SetUserVar=claude_state=%s\007' "$(printf %s "$state" | base64 | tr -d '\n')" >/dev/tty
  fi
} 2>/dev/null

# 入力待ち・許可待ちは、見ていなければ通知を出す (押すとそのタブへ移動)。hook を待たせないよう切り離す
if [[ ($state == "waiting" || $state == "attention") && -n ${WEZTERM_PANE:-} ]]; then
  setsid -f "$HOME/dotfiles/scripts/claude-notify-jump" "$state" "$WEZTERM_PANE" "$hook_json" >/dev/null 2>&1 </dev/null
fi

exit 0
