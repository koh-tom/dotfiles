#!/usr/bin/env python3
"""GitHub Actions の結果をバーと通知で知らせる。

  ci-status poll   各リポジトリの最新の実行を gh で取得し、終わったら通知 (systemd timer が2分ごと)
  ci-status bar    バーのピル用の JSON (gh を呼ばずに poll の結果を読むだけ)
  ci-status open   失敗しているもの (無ければ最新) の実行ページをブラウザで開く
  ci-status list   一覧を表示

見るリポジトリは ~/.config/dotfiles/ci-repos に1行1つ (owner/name、# でコメント)。
ファイルが無ければ ~/dotfiles の origin だけを見る。研究室のリポジトリ名などは公開リポジトリに書かないため、
このファイルは dotfiles の外に置く。
"""
import json
import os
import subprocess
import sys
import time
from datetime import datetime, timezone

HOME = os.path.expanduser("~")
CONFIG = os.path.join(os.environ.get("XDG_CONFIG_HOME", f"{HOME}/.config"), "dotfiles/ci-repos")
STATE = os.path.join(os.environ.get("XDG_STATE_HOME", f"{HOME}/.local/state"), "dotfiles/ci/state.json")


def repos():
    try:
        lines = open(CONFIG).read().splitlines()
        found = [l.split("#")[0].strip() for l in lines]
        found = [r for r in found if r and "/" in r]
        if found:
            return found
    except OSError:
        pass
    # 既定は dotfiles 自身 (origin の URL から owner/name を取る)
    try:
        url = subprocess.run(["git", "-C", f"{HOME}/dotfiles", "remote", "get-url", "origin"],
                             capture_output=True, text=True, timeout=5).stdout.strip()
    except Exception:
        return []
    for prefix in ("git@github.com:", "https://github.com/", "ssh://git@github.com/"):
        if url.startswith(prefix):
            return [url[len(prefix):].removesuffix(".git")]
    return []


def load_state():
    try:
        return json.load(open(STATE))
    except (OSError, json.JSONDecodeError):
        return {"repos": {}}


def save_state(state):
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    tmp = STATE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(state, f, ensure_ascii=False)
    os.replace(tmp, STATE)


def notify(title, body, urgency="normal"):
    subprocess.run(["notify-send", "--app-name=CI", f"--urgency={urgency}", title, body],
                   check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def latest_run(repo):
    out = subprocess.run(
        ["gh", "run", "list", "-R", repo, "-L", "1",
         "--json", "databaseId,status,conclusion,displayTitle,headBranch,url,workflowName,createdAt"],
        capture_output=True, text=True, timeout=30)
    if out.returncode != 0:
        return None, (out.stderr.strip().splitlines() or ["gh error"])[-1]
    runs = json.loads(out.stdout or "[]")
    return (runs[0] if runs else {}), None


def poll():
    state = load_state()
    old = state.get("repos", {})
    new = {}
    for repo in repos():
        try:
            run, err = latest_run(repo)
        except Exception as e:  # gh が無い・タイムアウトなど
            run, err = None, str(e)
        if run is None:
            new[repo] = dict(old.get(repo, {}), error=err)
            continue
        prev = old.get(repo, {})
        entry = {"run": run, "checked": int(time.time())}
        rid = run.get("databaseId")
        # 実行中だったものが終わったら1回だけ知らせる (初回の取得では知らせない)
        if rid and run.get("status") == "completed" and prev.get("run", {}).get("databaseId") == rid \
                and prev["run"].get("status") != "completed":
            ok = run.get("conclusion") == "success"
            name = repo.split("/")[-1]
            notify(f"{'✓' if ok else '✗'} {name}: CI {'成功' if ok else run.get('conclusion', '失敗')}",
                   f"{run.get('displayTitle', '')}\n{run.get('workflowName', '')} ({run.get('headBranch', '')})",
                   "normal" if ok else "critical")
        new[repo] = entry
    state["repos"] = new
    state["polled"] = int(time.time())
    save_state(state)


def summarize(state):
    running, failed, ok, errors = [], [], [], []
    for repo, e in state.get("repos", {}).items():
        run = e.get("run") or {}
        if e.get("error") and not run:
            errors.append((repo, e["error"]))
        elif run.get("status") and run["status"] != "completed":
            running.append((repo, run))
        elif run.get("conclusion") and run["conclusion"] != "success":
            failed.append((repo, run))
        elif run:
            ok.append((repo, run))
    return running, failed, ok, errors


def bar():
    state = load_state()
    running, failed, ok, errors = summarize(state)
    lines = []
    for label, items in (("実行中", running), ("失敗", failed), ("成功", ok)):
        for repo, run in items:
            lines.append(f"{label}  {repo}: {run.get('displayTitle', '')}")
    for repo, err in errors:
        lines.append(f"取得できない  {repo}: {err}")
    tooltip = "\n".join(lines) or "CI: 見ているリポジトリなし"
    if failed:
        out = {"text": f" {len(failed)}", "class": "failed", "tooltip": tooltip + "\nクリック: 失敗した実行を開く"}
    elif running:
        out = {"text": f" {len(running)}", "class": "running", "tooltip": tooltip}
    else:
        # すべて成功なら出さない (気にしなくてよい状態)
        out = {"text": "", "class": "ok", "tooltip": tooltip}
    print(json.dumps(out, ensure_ascii=False))


def open_run():
    running, failed, ok, _ = summarize(load_state())
    target = (failed or running or ok or [(None, {})])[0][1].get("url")
    if target:
        subprocess.Popen(["xdg-open", target], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def list_runs():
    state = load_state()
    for repo, e in state.get("repos", {}).items():
        run = e.get("run") or {}
        status = run.get("conclusion") or run.get("status") or e.get("error", "?")
        print(f"{status:12} {repo}  {run.get('displayTitle', '')}  {run.get('url', '')}")


cmd = sys.argv[1] if len(sys.argv) > 1 else "bar"
{"poll": poll, "bar": bar, "open": open_run, "list": list_runs}.get(cmd, lambda: sys.exit(f"usage: ci-status poll|bar|open|list"))()
