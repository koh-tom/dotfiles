#!/bin/bash

set -u

ROOT="${DOTFILES_ROOT:-$HOME/dotfiles}"
failures=0
warnings=0

pass() { printf '  \033[32m✓\033[0m %s\n' "$1"; }
fail() { printf '  \033[31m✗\033[0m %s\n' "$1"; failures=$((failures + 1)); }
warn() { printf '  \033[33m!\033[0m %s\n' "$1"; warnings=$((warnings + 1)); }

run_check() {
  local label=$1
  shift
  if "$@" >/dev/null 2>&1; then pass "$label"; else fail "$label"; fi
}

# Arch/Omarchy向けのチェック(Hyprland/Waybar/pacman等)と、Ubuntu/Debian等で
# 移植したツール群向けの縮小チェックを切り替える
is_arch_omarchy() { command -v omarchy >/dev/null 2>&1; }

# luac のバイナリ名はディストリで異なる (Arch: luac / Ubuntu: luac5.4 等)
luac_bin=$(command -v luac || command -v luac5.4 || command -v luac5.3 || command -v luac5.1 || true)

cd "$ROOT" || exit 1

# Stow パッケージ一覧は apply-dotfiles / CI と共通 (scripts/lib/packages.sh)
# shellcheck source=lib/packages.sh
source "$ROOT/scripts/lib/packages.sh"

printf '\nDotfiles Doctor\n\n'
if is_arch_omarchy; then
  printf 'Platform: Arch / Omarchy\n\n'
else
  printf 'Platform: %s (tool subset only — Hyprland/Waybar/Omarchy checks skipped)\n\n' "$(uname -s)"
fi

# CI (.github/workflows/check.yml) と同じ範囲: rc 直下と pluginconfig (atuin/carapace/television 等) 全部
run_check "Zsh syntax" zsh -n \
  zsh/.zshenv \
  zsh/.config/zsh/.zshrc \
  zsh/.config/zsh/rc/*.zsh \
  zsh/.config/zsh/rc/pluginconfig/*.zsh

if [[ -n $luac_bin ]]; then
  lua_ok=true
  while IFS= read -r file; do
    "$luac_bin" -p "$file" >/dev/null 2>&1 || lua_ok=false
  done < <(find wezterm themes quattro profiles tests nvim -name '*.lua' -type f -print)
  if $lua_ok; then pass "Lua syntax (wezterm/quattro/nvim/...)"; else fail "Lua syntax"; fi
else
  fail "No luac binary found (install lua/lua5.4)"
fi

run_check "WezTerm config load" timeout 15s wezterm \
  --config-file "$ROOT/wezterm/.config/wezterm/wezterm.lua" show-keys --lua
run_check "Fastfetch config" fastfetch \
  --config "$ROOT/fastfetch/.config/fastfetch/config.jsonc" --pipe

dotfiles_select_packages
if stow -n -v "${DOTFILES_STOW_OPTS[@]}" "${DOTFILES_PACKAGES[@]}" >/dev/null 2>&1; then
  pass "GNU Stow layout ($(dotfiles_platform): ${DOTFILES_PACKAGES[*]})"
else
  fail "GNU Stow layout has conflicts"
fi

generated=$(
  git ls-files | while IFS= read -r file; do
    if [[ -e $file && ( $file == *.zwc || $file == */.zcompdump* || $file == */.zsh_history ) ]]; then
      printf '%s\n' "$file"
    fi
  done
)
if [[ -z $generated ]]; then
  pass "No Zsh runtime state in repository"
else
  fail "Zsh runtime state found: ${generated//$'\n'/, }"
fi

# WezTerm安定版(20240203以前)はHyprland Waylandでウィンドウが出ない既知問題がある。
# wezterm.luaはバージョン自動判定でenable_waylandを決めるので、その仕組みの存在を検査する
wez_version=$(wezterm --version 2>/dev/null | awk '{print $2}' | cut -d- -f1)
if grep -q 'wez_build_date > 20240203' wezterm/.config/wezterm/wezterm.lua; then
  pass "WezTerm Wayland auto-detection (build ${wez_version:-unknown})"
elif grep -Eq '^\s*config\.enable_wayland\s*=\s*true' wezterm/.config/wezterm/wezterm.lua \
  && [[ -n $wez_version && $wez_version -le 20240203 ]] 2>/dev/null; then
  fail "enable_wayland=true + wezterm $wez_version はHyprlandでウィンドウ非表示になる"
else
  pass "WezTerm Wayland compatibility"
fi

# scriptsは全て実行可能であること
# (scripts/lib/ は source 専用のライブラリなので対象外)
non_exec=$(find scripts -path scripts/lib -prune -o -type f ! -perm -u+x -print | tr '\n' ' ')
if [[ -z $non_exec ]]; then
  pass "All scripts are executable"
else
  fail "Non-executable scripts: $non_exec"
fi

# Spursテーマの生成物が揃っていること。一覧は build_theme.py 自身に聞く
# (Quattro: 同梱テーマと同じ最小構成 / 3.x: 全アプリ分)
spurs_missing=""
while IFS= read -r f; do
  [[ -f themes/spurs/$f ]] || spurs_missing+="$f "
done < <(python3 -B tools/build_theme.py --list)
if [[ -z $spurs_missing ]]; then
  pass "Spurs theme is complete"
else
  fail "Spurs theme missing files (run: mise run install-spurs): $spurs_missing"
fi
if dotfiles_is_quattro; then
  # 3.x 用の生成物が残っていると omarchy-theme-set-templates がテンプレート生成を飛ばす
  spurs_stale=""
  while IFS= read -r f; do
    [[ -e themes/spurs/$f ]] && spurs_stale+="$f "
  done < <(comm -13 <(python3 -B tools/build_theme.py --list --quattro | sort) \
                    <(python3 -B tools/build_theme.py --list --legacy | sort))
  if [[ -z $spurs_stale ]]; then
    pass "Spurs theme has no Omarchy 3.x leftovers"
  else
    fail "Spurs theme has 3.x files that block Quattro templates (run: mise run install-spurs): $spurs_stale"
  fi
fi
if is_arch_omarchy && [[ -e $HOME/.config/omarchy/themes/spurs || -L $HOME/.config/omarchy/themes/spurs ]]; then
  if [[ -L $HOME/.config/omarchy/themes/spurs && $(realpath -m "$HOME/.config/omarchy/themes/spurs") == "$(realpath themes/spurs)" ]]; then
    pass "Spurs theme installed as a link to themes/spurs"
  else
    warn "$HOME/.config/omarchy/themes/spurs is a stale copy (run: mise run install-spurs)"
  fi
fi

if is_arch_omarchy; then
  # パッケージマニフェストの充足 (AURのwezterm-nightly-binはprovides weztermなので通常名で確認)
  pkg_missing=""
  while IFS= read -r pkg; do
    pacman -Qq "$pkg" >/dev/null 2>&1 || pkg_missing+="$pkg "
  done < <(grep -vhE '^\s*(#|$)' packages/pacman.txt)
  if [[ -z $pkg_missing ]]; then
    pass "Pacman manifest satisfied"
  else
    fail "Missing packages (run: ./scripts/install-packages): $pkg_missing"
  fi
elif command -v dpkg >/dev/null 2>&1; then
  pkg_missing=""
  while IFS= read -r pkg; do
    dpkg -s "$pkg" >/dev/null 2>&1 || pkg_missing+="$pkg "
  done < <(grep -vhE '^\s*(#|$)' packages/apt.txt)
  if [[ -z $pkg_missing ]]; then
    pass "Apt manifest satisfied"
  else
    fail "Missing packages (run: ./scripts/install-packages): $pkg_missing"
  fi
fi

# CLIテーマキャッシュ (無ければzsh起動時に生成されるためwarn)
if [[ -r ${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles/cli-theme.zsh ]]; then
  pass "CLI theme cache generated"
else
  warn "CLI theme cache missing (generated on next shell start)"
fi

required_commands=(wezterm zsh mise stow starship fastfetch zoxide nvim lazygit yazi claude czg)
is_arch_omarchy && required_commands+=(omarchy)
for command_name in "${required_commands[@]}"; do
  if command -v "$command_name" >/dev/null 2>&1; then
    pass "Command: $command_name"
  else
    fail "Missing command: $command_name"
  fi
done

# コミット署名 (任意機能なのでwarn止まり)
if git config --get commit.gpgsign 2>/dev/null | grep -q true; then
  pass "Git commit signing enabled"
elif [[ -S $HOME/.1password/agent.sock ]]; then
  warn "1Password agent is up but signing is off (run: mise run setup-signing)"
else
  warn "Git commit signing not set up (1Password SSH agent + mise run setup-signing)"
fi

for command_name in aws plamo-translate; do
  if command -v "$command_name" >/dev/null 2>&1; then
    pass "Optional command: $command_name"
  else
    warn "Optional command not installed: $command_name"
  fi
done

if is_arch_omarchy; then
  terminal_id=$(xdg-terminal-exec --print-id 2>/dev/null || true)
  if [[ $terminal_id == org.wezfurlong.wezterm.desktop* ]]; then
    pass "WezTerm is the default terminal"
  else
    warn "Default terminal is ${terminal_id:-unknown}"
  fi

  if hyprctl version >/dev/null 2>&1; then
    errors=$(hyprctl configerrors 2>/dev/null || true)
    if [[ -z $errors ]]; then pass "Hyprland config"; else fail "Hyprland config: $errors"; fi
  else
    warn "Hyprland socket unavailable; configerrors skipped"
  fi

  if [[ -e /usr/share/omarchy/default/hypr/bootstrap.lua ]]; then
    # Omarchy 4 (Quattro): Lua 構成。.conf を強制する設定や 0.56 固定が残っていたら壊れる。
    if [[ -L $HOME/.config/hypr/hyprland.lua && $(readlink "$HOME/.config/hypr/hyprland.lua") == *dotfiles/quattro/* ]]; then
      pass "hyprland.lua is the dotfiles port (quattro/)"
    else
      warn "$HOME/.config/hypr/hyprland.lua is not the dotfiles port; run scripts/migrate-to-quattro post"
    fi
    if [[ $(systemctl --user show-environment 2>/dev/null | grep -c '^HYPRLAND_CONFIG=') -gt 0 ]]; then
      fail "HYPRLAND_CONFIG still set (forces legacy .conf); remove ~/.config/environment.d/hyprland-config.conf and re-login"
    else
      pass "HYPRLAND_CONFIG not forced"
    fi
    # 3.x 時代の stow で張った Waybar / menu.sh のリンクは Quattro では使われない
    leftover_links=""
    for link in "$HOME/.config/waybar" "$HOME/.config/omarchy/extensions/menu.sh"; do
      [[ -L $link && $(realpath -m "$link") == "$(realpath "$ROOT")/"* ]] && leftover_links+="$link "
    done
    if [[ -z $leftover_links ]]; then
      pass "No Omarchy 3.x links (waybar, menu.sh)"
    else
      warn "Omarchy 3.x links still stowed (run: mise run apply): $leftover_links"
    fi
    if grep -qE '^IgnorePkg *=.*\bhyprland\b' /etc/pacman.conf 2>/dev/null; then
      warn "hyprland still in IgnorePkg; Quattro follows upstream Hyprland, remove the pin"
    else
      pass "hyprland not pinned"
    fi
  else
    # Omarchy 3.x (.conf): Hyprland 0.56 は hyprland.lua を .conf より優先し、0.57 で .conf が廃止された。
    # Quattro へ移行するまで: lua ファイル無し / 明示パス / 0.56 固定 を確認する。
    if [[ -e $HOME/.config/hypr/hyprland.lua ]]; then
      fail "$HOME/.config/hypr/hyprland.lua exists (shadows hyprland.conf); move it away and re-login"
    else
      pass "No hyprland.lua shadowing hyprland.conf"
    fi
    if [[ $(systemctl --user show-environment 2>/dev/null | grep -c '^HYPRLAND_CONFIG=') -gt 0 ]]; then
      pass "HYPRLAND_CONFIG pinned to hyprland.conf (environment.d)"
    else
      warn "HYPRLAND_CONFIG not in user environment; run: systemctl --user daemon-reload (then re-login)"
    fi
    hypr_ver=$(pacman -Q hyprland 2>/dev/null | awk '{print $2}')
    if [[ -n $hypr_ver && $hypr_ver == 0.5[7-9]* || $hypr_ver == 0.[6-9]* || $hypr_ver == [1-9]* ]]; then
      fail "hyprland $hypr_ver drops .conf support; downgrade to 0.56.x or migrate to Omarchy 4 (scripts/migrate-to-quattro)"
    elif [[ -n $hypr_ver ]]; then
      pass "hyprland $hypr_ver still reads hyprland.conf"
    fi
    if grep -qE '^IgnorePkg *=.*\bhyprland\b' /etc/pacman.conf 2>/dev/null; then
      pass "hyprland pinned via IgnorePkg"
    else
      warn "hyprland not in IgnorePkg; next update may pull 0.57+ (Lua-only)"
    fi
  fi

  omarchy_current="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/current"
  [[ -d $omarchy_current/theme ]] || omarchy_current="$HOME/.config/omarchy/current"
  if [[ -r $omarchy_current/theme/colors.toml ]]; then
    pass "Omarchy palette available ($omarchy_current)"
  else
    fail "Omarchy palette missing"
  fi
fi

printf '\nResult: %d failure(s), %d warning(s)\n' "$failures" "$warnings"
(( failures == 0 ))
