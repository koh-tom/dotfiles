#!/bin/bash

# Omarchyの現在パレットから、ターミナル内CLIツールの配色を生成する。
# theme-setフックと .zshrc の鮮度チェックから呼ばれる。
# 出力:
#   $XDG_CACHE_HOME/dotfiles/cli-theme.zsh  (fzf / bat / zsh-autosuggestions)
#   ~/.config/lazygit/config.yml            (テーマ + delta pager。全体を生成)
#   ~/.config/yazi/theme.toml               (Yazi 26+ スキーマ)

set -euo pipefail

# 4.x (Quattro) は ~/.local/state/omarchy/current、3.x は ~/.config/omarchy/current
omarchy_current="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/current"
[[ -d $omarchy_current/theme ]] || omarchy_current="$HOME/.config/omarchy/current"
theme_file="$omarchy_current/theme/colors.toml"
out_dir="${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles"
out_file="$out_dir/cli-theme.zsh"

# Catppuccin Mocha互換のフォールバック
declare -A C=(
  [accent]="#cba6f7" [foreground]="#cdd6f4" [background]="#1e1e2e"
  [color0]="#45475a" [color1]="#f38ba8" [color2]="#a6e3a1" [color3]="#f9e2af"
  [color4]="#89b4fa" [color5]="#cba6f7" [color6]="#94e2d5" [color7]="#bac2de"
  [color8]="#585b70" [color15]="#cdd6f4"
)

if [[ -r $theme_file ]]; then
  while IFS='=' read -r key value; do
    key=${key//[[:space:]]/}
    value=${value//[[:space:]\"\']/}
    [[ -n $key && $value == \#* ]] && C["$key"]=$value
  done <"$theme_file"
fi

mkdir -p "$out_dir"
cat >"$out_file" <<EOF
# Generated by generate-cli-theme — 手で編集しない (source: Omarchy current theme)
export FZF_DEFAULT_OPTS="--border=rounded --color=bg:-1,gutter:-1,fg:${C[foreground]},fg+:${C[color15]},bg+:${C[color0]},hl:${C[accent]},hl+:${C[accent]},prompt:${C[accent]},pointer:${C[color3]},marker:${C[color3]},spinner:${C[color5]},info:${C[color8]},header:${C[color8]},border:${C[color8]}"
export ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=${C[color8]}"
# ansiテーマは端末のANSI 16色 = Omarchyパレットをそのまま使う
export BAT_THEME="ansi"
EOF

# --- lazygit (設定ファイル全体を生成する。手で編集しない) ---
lazygit_dir="$HOME/.config/lazygit"
mkdir -p "$lazygit_dir"
cat >"$lazygit_dir/config.yml" <<EOF
# Generated by generate-cli-theme — 手で編集しない
gui:
  nerdFontsVersion: "3"
  border: rounded
  showBottomLine: false
  theme:
    activeBorderColor:
      - "${C[accent]}"
      - bold
    inactiveBorderColor:
      - "${C[color8]}"
    searchingActiveBorderColor:
      - "${C[color3]}"
      - bold
    optionsTextColor:
      - "${C[color4]}"
    selectedLineBgColor:
      - "${C[color0]}"
    cherryPickedCommitBgColor:
      - "${C[color0]}"
    cherryPickedCommitFgColor:
      - "${C[accent]}"
    unstagedChangesColor:
      - "${C[color1]}"
    defaultFgColor:
      - "${C[foreground]}"
git:
  # 差分ビューで | を押すと delta ⇔ difftastic(構文差分) を切り替え
  pagers:
    - colorArg: always
      pager: delta --paging=never --line-numbers --syntax-theme ansi
    - externalDiffCommand: difft --color=always --display=inline
EOF

# --- yazi (Yazi 26+ の [mgr] スキーマ) ---
yazi_dir="$HOME/.config/yazi"
mkdir -p "$yazi_dir"
cat >"$yazi_dir/theme.toml" <<EOF
# Generated by generate-cli-theme — 手で編集しない
[mgr]
cwd = { fg = "${C[accent]}", bold = true }
hovered = { fg = "${C[background]}", bg = "${C[accent]}" }
preview_hovered = { underline = true }
find_keyword = { fg = "${C[color3]}", italic = true }
find_position = { fg = "${C[color5]}", bg = "reset", italic = true }
marker_selected = { fg = "${C[color2]}", bg = "${C[color2]}" }
marker_copied = { fg = "${C[color3]}", bg = "${C[color3]}" }
marker_cut = { fg = "${C[color1]}", bg = "${C[color1]}" }
count_selected = { fg = "${C[background]}", bg = "${C[color2]}" }
count_copied = { fg = "${C[background]}", bg = "${C[color3]}" }
count_cut = { fg = "${C[background]}", bg = "${C[color1]}" }
border_symbol = "│"
border_style = { fg = "${C[color8]}" }

[status]
separator_open = ""
separator_close = ""
mode_normal = { fg = "${C[background]}", bg = "${C[accent]}", bold = true }
mode_select = { fg = "${C[background]}", bg = "${C[color2]}", bold = true }
mode_unset = { fg = "${C[background]}", bg = "${C[color3]}", bold = true }
progress_label = { fg = "${C[foreground]}", bold = true }
progress_normal = { fg = "${C[accent]}", bg = "${C[color0]}" }
progress_error = { fg = "${C[color1]}", bg = "${C[color0]}" }

[tabs]
active = { fg = "${C[background]}", bg = "${C[accent]}" }
inactive = { fg = "${C[foreground]}", bg = "${C[color0]}" }
EOF

printf 'CLI theme written: %s (+ lazygit, yazi)\n' "$out_file"
