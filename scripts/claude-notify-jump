#!/bin/bash
# Claude Code が入力待ち / 許可待ちになったとき、見ていなければデスクトップ通知を出す。
# 通知の「開く」を押すと、そのセッションが動いている WezTerm のタブ・ペインへ移動する。
#
#   claude-notify-jump <waiting|attention> <pane_id> [hook の JSON]
#
# claude-wezterm-state から裏で (setsid) 呼ばれる。hook は待たない。
set -u

state="${1:-}"
pane="${2:-}"
json="${3:-}"
[[ -n $pane ]] || exit 0
command -v wezterm >/dev/null && command -v notify-send >/dev/null || exit 0

# 今まさにそのペインを見ているなら通知しない
# (Hyprland のアクティブウィンドウが WezTerm で、WezTerm のフォーカス中ペインが同じ)
active_class=$(hyprctl activewindow -j 2>/dev/null | jq -r '.class // ""')
if [[ $active_class == "org.wezfurlong.wezterm" ]]; then
  focused=$(wezterm cli list-clients --format json 2>/dev/null | jq -r '.[0].focused_pane_id // empty')
  [[ $focused == "$pane" ]] && exit 0
fi

cwd=$(jq -r '.cwd // empty' <<<"$json" 2>/dev/null)
project=${cwd##*/}
[[ -n $project ]] || project="Claude Code"
message=$(jq -r '.message // empty' <<<"$json" 2>/dev/null)
if [[ $state == "attention" ]]; then
  title="✳ $project: 確認が必要です"
  [[ -n $message ]] || message="許可または入力を待っています"
  urgency=critical
else
  title="✳ $project: 終わりました"
  [[ -n $message ]] || message="入力を待っています"
  urgency=normal
fi

action=$(notify-send --app-name="Claude Code" --urgency="$urgency" --expire-time=15000 \
  --action=open="開く" "$title" "$message" 2>/dev/null)
[[ $action == "open" ]] || exit 0

# タブ・ペインを切り替え、そのペインを持つ WezTerm ウィンドウを Hyprland で前に出す
# (管制パネルと同じ処理。ウィンドウのタイトルに付く "[n/m] " やスピナー記号も考慮して探す)
exec "$HOME/dotfiles/scripts/claude-sessions" --jump "$pane"
