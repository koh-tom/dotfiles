#!/bin/bash
# dotfiles のマニュアル (Pond の User Manual 風)。
# 「まず覚えるキー」と、tips/tips.tsv の全 tip を分類ごとの表にまとめ、glow で読む。
# tips.tsv を足せば勝手に育つ。Omarchy メニューの Setup > Config > Dotfiles > Manual と SUPER+SHIFT+K から開く。
#
#   dotfiles-manual          浮いた端末で開く
#   dotfiles-manual --print  Markdown を標準出力へ (確認用)
set -euo pipefail

dotfiles="$HOME/dotfiles"
tips="$dotfiles/tips/tips.tsv"
out="${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles/manual.md"

generate() {
  cat <<'EOF'
# dotfiles マニュアル

困ったら **SUPER+SHIFT+K** でいつでもここに戻れます。Omarchy 標準のキー一覧は **SUPER+K**。

## まず覚える 13 個

| キー | できること |
|---|---|
| `SUPER+CTRL+↑` / 3本指で上にスワイプ | ワークスペース一覧 (クリックで移動、ドラッグでウィンドウを移す) |
| 3本指で左右にスワイプ | ワークスペースを切り替え |
| `SUPER+Space` | Omarchy メニュー (アプリ・設定・テーマ) |
| `SUPER+CTRL+V` | クリップボード履歴 (`SUPER+V` は貼り付け) |
| `` SUPER+` `` | 上から出るドロップダウン端末 |
| `CTRL+Q` → `g` | WezTerm: プロジェクトを開く |
| `CTRL+Q` → `c` | WezTerm: Claude Code のセッションを切り替え |
| `ALT+←/→` | WezTerm: タブを移動 |
| `CTRL+SHIFT+H/J/K/L` | WezTerm: ペインを移動 |
| `CTRL+Q` → `/` | WezTerm: 全キーと全スニペットのチートシート |
| `SUPER+ALT+P` | ワークスペースのプリセット (研究・開発・連絡) |
| `SUPER+ALT+N` | ひらめきメモ (Obsidian の今日のノートに1行追記) |
| `CTRL+Q` → `h` | WezTerm: 研究室などのマシンを新しいタブで開く |

WezTerm の上の帯には、今開いているアプリ (シェル・Claude・nvim・lazygit・yazi) のキーが出ています。

## 便利な仕組み

- **Claude Code**: 入力待ち・許可待ちになると通知が出て、「開く」でそのタブへ移動します。
- **壁紙**: 時刻で切り替わります (朝・昼・夕・夜)。固定・戻すは Omarchy メニューの Setup > Config > Dotfiles > Wallpaper (または `~/dotfiles/scripts/wallpaper-time custom` / `dynamic`)。
- **WezTerm のセッション**: 15分ごとに自動保存。`CTRL+Q` → `Shift+R` で選んで戻せます。
- **朝のブリーフィング**: その日最初のログインで、予定・天気・研究室ジョブ・Claude の使用量・締め切りを1枚で出します。もう一度見るときは `~/dotfiles/scripts/briefing`。締め切りは `~/dotfiles/presets/deadlines.tsv`、予定の ICS は `~/.config/dotfiles/briefing.toml` (`briefing --help`)。
- **発表モード**: pdfpc や画面共有の間は自動で通知が止まり、終わると戻ります。
- **プリセット**: 中身は `~/dotfiles/presets/workspaces.json`。起動済みのアプリは新しく開かずに移動します。
- **バックアップ**: Backrest の画面 <http://127.0.0.1:9898>。
- **困ったとき**: `mise run doctor` (dotfiles の自己点検)、`tests/quattro-parity/run` (移行前との比較)。
EOF

  [[ -r $tips ]] || return 0
  local category
  for category in Hyprland WezTerm Shell Git Neovim mise Tools; do
    grep -q "^${category}"$'\t' "$tips" || continue
    printf '\n## %s\n\n| キー | 内容 |\n|---|---|\n' "$category"
    awk -F'\t' -v c="$category" '$1 == c { gsub(/\|/, "\\|", $2); gsub(/\|/, "\\|", $3); printf "| `%s` | %s |\n", $2, $3 }' "$tips"
  done
  # 上の順に無い分類も漏らさない
  awk -F'\t' '!/^#/ && NF >= 3 { print $1 }' "$tips" | sort -u | while read -r category; do
    case $category in Hyprland | WezTerm | Shell | Git | Neovim | mise | Tools) continue ;; esac
    printf '\n## %s\n\n| キー | 内容 |\n|---|---|\n' "$category"
    awk -F'\t' -v c="$category" '$1 == c { printf "| `%s` | %s |\n", $2, $3 }' "$tips"
  done
}

if [[ ${1:-} == --print ]]; then
  generate
  exit 0
fi

mkdir -p "$(dirname "$out")"
generate >"$out"
# WezTerm は xdg-terminal-exec の --app-id を使わないので、--class を直接渡す (フロートのルールは personal/manual.lua)
# WEZTERM_DROPDOWN: セッション復元・自動保存を読まない (ドロップダウン端末と同じ扱い)
exec setsid uwsm-app -- env WEZTERM_DROPDOWN=1 wezterm start --always-new-process --class org.omarchy.dotfiles-manual -- glow -p "$out"
