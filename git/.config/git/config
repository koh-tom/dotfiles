[core]
    pager = delta

[init]
    defaultBranch = main

[pull]
    rebase = true

[push]
    autoSetupRemote = true

[diff]
    algorithm = histogram
    colorMoved = plain
    mnemonicPrefix = true

[commit]
    verbose = true

[column]
    ui = auto

[branch]
    sort = -committerdate

[tag]
    sort = -version:refname

[rerere]
    enabled = true
    autoupdate = true

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true    # use 'n' and 'p' to move between diff sections
    light = false      # set to true if you're in a terminal w/ a light background color (e.g. Solarized Light)
    side-by-side = true
    line-numbers = true
    # ansi = 端末のANSI色を使う。Omarchyテーマ変更に自動追従する
    syntax-theme = ansi

# difftastic (構文を理解する差分)。通常の diff は delta のまま、明示したときだけ使う
#   git dft        … 作業ツリーの差分     git dlog / git dshow … ログ・コミットを構文差分で
[difftool "difftastic"]
    cmd = difft "$LOCAL" "$REMOTE"

[difftool]
    prompt = false

[pager]
    difftool = true

[alias]
    dft = difftool --tool=difftastic
    dlog = -c diff.external=difft log -p --ext-diff
    dshow = -c diff.external=difft show --ext-diff

[merge]
    conflictstyle = zdiff3
