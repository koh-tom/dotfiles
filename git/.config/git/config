[core]
    pager = delta

[init]
    defaultBranch = main

[pull]
    rebase = true

[push]
    autoSetupRemote = true

[diff]
    algorithm = histogram
    colorMoved = plain
    mnemonicPrefix = true

[commit]
    verbose = true

[column]
    ui = auto

[branch]
    sort = -committerdate

[tag]
    sort = -version:refname

[rerere]
    enabled = true
    autoupdate = true

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true    # use 'n' and 'p' to move between diff sections
    light = false      # set to true if you're in a terminal w/ a light background color (e.g. Solarized Light)
    side-by-side = true
    line-numbers = true
    # ansi = 端末のANSI色を使う。Omarchyテーマ変更に自動追従する
    syntax-theme = ansi

[merge]
    conflictstyle = zdiff3
