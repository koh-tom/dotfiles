#!/bin/bash

# Omarchy has already generated the current theme by the time this hook runs.

# fzf / bat / zsh 系のCLI配色を新パレットで再生成
"$HOME/dotfiles/scripts/generate-cli-theme" >/dev/null 2>&1 || true

# Touching the entry point makes WezTerm reload colors without restarting panes.
wezterm_config="$HOME/.config/wezterm/wezterm.lua"
[[ -e $wezterm_config ]] && touch "$wezterm_config"


# テーマを替えても、壁紙のファイル名が前のテーマと同じ (backgrounds/1.png など) だと
# Omarchy の背景が画像を読み直さず前のテーマの壁紙が残る。current/ の下は同じパスになるので、
# テーマの元のディレクトリにある同じ名前のファイル (パスがテーマごとに違う) で設定し直す
cur="$HOME/.local/state/omarchy/current"
bg=$(readlink -f "$cur/background" 2>/dev/null)
name=$(cat "$cur/theme.name" 2>/dev/null)
if [[ -n $bg && -n $name ]]; then
  for dir in "$HOME/.config/omarchy/themes/$name" "/usr/share/omarchy/themes/$name"; do
    src="$dir/backgrounds/${bg##*/}"
    if [[ -f $src ]]; then
      omarchy-shell -q background set "$(readlink -f "$src")" >/dev/null 2>&1
      break
    fi
  done
fi
exit 0
